// TVM TI DSP + TIDL Validation Pipeline
//
// Builds all TVM artifacts for AM67A, deploys firmware, and runs
// the full DSP + TIDL test matrix on host emulation and hardware.
//
// Jenkins setup:
//   1. Install plugins: Pipeline, JUnit, Lockable Resources,
//      Timestamper, Build Timeout, Pipeline Stage View
//   2. Create lockable resource "am67a-dsp-board" in
//      Manage Jenkins > Lockable Resources
//   3. Pipeline job: SCM, script path "tests/ti-dsp-runtime/Jenkinsfile"
//   4. Label the DSP-capable node "ti-dsp" (or use "agent any")
//   5. Configure git HTTP proxy on the Jenkins node (as the jenkins user):
//        git config --global http.proxy http://webproxy.ext.ti.com:80
//        git config --global https.proxy http://webproxy.ext.ti.com:80
//      This is required because tvm-ffi has nested submodules (dlpack,
//      libbacktrace) on github.com.  The Jenkins Git plugin injects the
//      proxy for direct submodules but not for recursive (nested) ones,
//      so git must be configured to proxy HTTPS requests globally.
//   6. Pre-cache torchvision model weights on the Jenkins node.
//      Several DSP tests load pretrained models (squeezenet, resnet, etc.)
//      which torchvision downloads from download.pytorch.org on first use.
//      The Jenkins node cannot reach this URL through the corporate proxy,
//      so the weights must be cached ahead of time:
//        # On a machine with internet access, run:
//        python -c "
//        from torchvision import models
//        for m in ['squeezenet1_1', 'shufflenet_v2_x1_0', 'mobilenet_v2',
//                  'mobilenet_v3_small', 'mobilenet_v3_large',
//                  'efficientnet_b0', 'densenet121', 'resnet34', 'resnet18']:
//            getattr(models, m)(weights='DEFAULT')
//        import torch
//        torch.hub.load('ultralytics/yolov5', 'yolov5n', pretrained=True)
//        torch.hub.load('ultralytics/yolov5', 'yolov5s', pretrained=True)
//        "
//        This caches: torchvision weights (~500 MB), yolov5 repo + .pt
//        weights under ~/.cache/torch/hub/.  YOLOv5 models require
//        the ultralytics/yolov5 repo on sys.path (torch.hub clones it
//        on first use) AND the pretrained .pt weights at
//        ~/.cache/torch/hub/checkpoints/yolov5{n,s}.pt.  Without
//        cached copies the Jenkins node cannot reach github.com.
//
//        # Then copy the entire cache to the Jenkins node:
//        scp -r ~/.cache/torch sdomcbuild@<node>:~/.cache/torch

pipeline {
    agent { label 'relax-c7x' }

    triggers {
        cron('H 1 * * *')
    }

    options {
        timestamps()
        timeout(time: 6, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'SKIP_LONG_TESTS',
            defaultValue: false,
            description: 'Only run quick tests in all validate stages'
        )
        booleanParam(
            name: 'SKIP_DEPLOY',
            defaultValue: false,
            description: 'Skip firmware/ARM client deploy (assume pre-deployed)'
        )
        booleanParam(
            name: 'BUILD_ONLY',
            defaultValue: false,
            description: 'Only run the build stage, skip all validation'
        )
        booleanParam(
            name: 'SKIP_HOST_VALIDATION',
            defaultValue: false,
            description: 'Skip the host emulation (c7x_host) validation stage'
        )
        booleanParam(
            name: 'SKIP_HW_VALIDATION',
            defaultValue: false,
            description: 'Skip the hardware (c7x_dload + TIDL HW) validation stage'
        )
        booleanParam(
            name: 'SKIP_TIDL_TESTS',
            defaultValue: true,
            description: 'Skip all TIDL tests (host and hardware)'
        )
        booleanParam(
            name: 'CLEAN_WORKSPACE',
            defaultValue: false,
            description: 'Wipe the workspace before building (full clean rebuild)'
        )
        booleanParam(
            name: 'KEEP_TEMP_DIRS',
            defaultValue: false,
            description: 'Retain /tmp/dsp_build_* directories for post-mortem debugging'
        )
        booleanParam(
            name: 'SKIP_WHEEL_TESTS',
            defaultValue: false,
            description: 'Skip wheel packaging tests (compile + inference e2e on board)'
        )
    }

    environment {
        TVM_HOME                       = "${WORKSPACE}"
        // Pre-cached model weights at ~/.cache/torch/hub/checkpoints/
        // avoid network downloads during tests (see CLAUDE.md setup).
        TORCH_HOME                     = "${HOME}/.cache/torch"
        // Disable upstream TVM CI request hook (conftest.py loads it
        // when CI=true).  Our DSP tests are not upstream CI and the
        // hook blocks legitimate model downloads.
        CI                             = 'false'
        VIRTUAL_ENV                    = "${WORKSPACE}/.venv"
        PATH                           = "${WORKSPACE}/.venv/bin:${PATH}"
        http_proxy                     = 'http://webproxy.ext.ti.com:80'
        https_proxy                    = 'http://webproxy.ext.ti.com:80'
        no_proxy                       = 'ti.com,.ti.com,localhost,127.0.0.1'
        TI_CGT_C7000_PATH             = '/opt/ti/c7x/ti-cgt-c7000_5.0.1.LTS'
        TI_SYSCONFIG_ROOT              = '/opt/ti/sysconfig'
        PSDK_INSTALL_PATH              = '/opt/ti/am67a/ti-processor-sdk-rtos-j722s-evm-11_00_00_06'
        MCU_PLUS_SDK_PATH              = '/opt/ti/am67a/ti-processor-sdk-rtos-j722s-evm-11_00_00_06/mcu_plus_sdk_j722s_11_00_00_12'
        C7X_MMA_TIDL_PATH             = "${WORKSPACE}/c7x-mma-tidl"
        AM67A_TARGET                   = 'am67a'
        ENABLE_SDK_11_0_COMPATIBILITY  = '1'
    }

    stages {

        // Set DSP_KEEP_TEMP from the KEEP_TEMP_DIRS parameter so that
        // dsp_utils.py preserves /tmp/dsp_build_* dirs on test failure.
        // Cannot use params in the environment block directly, so we
        // set it here as a pipeline-wide env var.
        stage('Init') {
            steps {
                // Clear stale test results so JUnit only sees this run's XMLs
                sh 'rm -rf results && mkdir -p results'
                script {
                    if (params.KEEP_TEMP_DIRS) {
                        env.DSP_KEEP_TEMP = '1'
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // BUILD
        // ----------------------------------------------------------------
        stage('Build') {
            options {
                timeout(time: 30, unit: 'MINUTES')
            }
            stages {
                stage('Clean Workspace') {
                    when {
                        expression { return params.CLEAN_WORKSPACE }
                    }
                    steps {
                        // Removes build dirs, venv, and cached artifacts.
                        // The SCM checkout is re-done by Jenkins before
                        // this stage runs, so source files are intact.
                        sh '''
                            rm -rf build .venv artifacts packaging/ti_dsp/staging
                            rm -rf src/runtime/ti_dsp/build-*
                            rm -rf src/runtime/ti_dsp/firmware/c7x/dsp/build
                            rm -rf src/runtime/ti_dsp/firmware/c7x/arm/build
                            rm -rf c7x-mma-tidl
                        '''
                    }
                }

                stage('Python Setup') {
                    steps {
                        sh '''
                            if [ ! -d "${TORCH_HOME}/hub/checkpoints" ]; then
                                echo "ERROR: Torchvision model cache not found at ${TORCH_HOME}/hub/checkpoints"
                                echo ""
                                echo "DSP tests require pre-cached pretrained model weights because the"
                                echo "Jenkins node cannot download them from download.pytorch.org."
                                echo ""
                                echo "Fix: on a machine with internet access, run:"
                                echo "  python -c \\"from torchvision import models; [getattr(models, m)(weights='DEFAULT') for m in ['squeezenet1_1','shufflenet_v2_x1_0','mobilenet_v2','mobilenet_v3_small','mobilenet_v3_large','efficientnet_b0','densenet121','resnet34','resnet18']]\\""
                                echo "  scp -r ~/.cache/torch ${USER}@$(hostname):${TORCH_HOME}"
                                exit 1
                            fi
                            test -d .venv || uv venv .venv
                            uv pip install numpy pytest scipy psutil ml_dtypes build pandas tqdm seaborn
                            uv pip install "torch>=2.5,<2.11" "torchvision>=0.20,<0.26" --extra-index-url https://download.pytorch.org/whl/cpu
                            uv pip install ultralytics
                            uv pip install -e 3rdparty/tvm-ffi
                        '''
                    }
                }

                stage('TVM Core') {
                    steps {
                        sh '''
                            mkdir -p build
                            cp cmake/config.cmake build/
                            cd build
                            cmake -G Ninja ..
                            ninja
                        '''
                    }
                }

                stage('DSP Runtime') {
                    steps {
                        sh '''
                            cd src/runtime/ti_dsp
                            bash build_runtime.sh c7x_host
                            bash build_runtime.sh c7x
                        '''
                    }
                }

                stage('Clone c7x-mma-tidl') {
                    steps {
                        sh '''
                            if [ -d c7x-mma-tidl/.git ]; then
                                cd c7x-mma-tidl
                                git fetch --depth=1 origin tvm-relax
                                git checkout tvm-relax
                                git reset --hard origin/tvm-relax
                                git submodule update --init --depth=1
                            else
                                rm -rf c7x-mma-tidl
                                git clone --depth=1 --branch tvm-relax \
                                    --recurse-submodules --shallow-submodules \
                                    ssh://git@bitbucket.itg.ti.com/mctools/c7x-mma-tidl.git \
                                    c7x-mma-tidl
                            fi
                        '''
                    }
                }

                stage('TIDL Build (c7x-mma-tidl)') {
                    steps {
                        sh '''
                            cd ${C7X_MMA_TIDL_PATH}
                            bash build_j722s.sh
                        '''
                    }
                }

                stage('C7x Firmware') {
                    steps {
                        sh '''
                            cd src/runtime/ti_dsp/firmware/c7x/dsp
                            ./build.sh
                        '''
                    }
                }

                stage('ARM Client') {
                    steps {
                        sh '''
                            cd src/runtime/ti_dsp/firmware/c7x/arm
                            ./build.sh
                        '''
                    }
                }

                stage('Build & Install Wheels') {
                    steps {
                        sh '''
                            bash packaging/ti_dsp/build_wheel.sh --target x86
                            bash packaging/ti_dsp/build_wheel.sh --target arm64
                            uv pip install --force-reinstall --no-deps \
                                packaging/ti_dsp/staging-x86/dist/tvm_ti_c7x_compile-*.whl
                        '''
                    }
                }

                stage('Deploy to AM67A') {
                    when {
                        expression { return !params.SKIP_DEPLOY }
                    }
                    steps {
                        sh '''
                            cd src/runtime/ti_dsp/firmware/c7x
                            ./deploy-c7x.sh dsp/build/c7x_compute.out
                        '''
                        sh '''
                            cd src/runtime/ti_dsp/firmware/c7x/arm
                            ./build.sh deploy
                        '''
                    }
                }

                stage('Archive Build Artifacts') {
                    steps {
                        sh '''
                            rm -rf artifacts
                            mkdir -p artifacts
                            cp packaging/ti_dsp/staging-x86/dist/tvm_ti_c7x_compile-*.whl    artifacts/
                            cp packaging/ti_dsp/staging-arm64/dist/tvm_ti_c7x_inference-*.whl artifacts/
                        '''
                        archiveArtifacts artifacts: 'artifacts/**', fingerprint: true
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // VALIDATE HOST (parallel -- no hardware access)
        // ----------------------------------------------------------------
        stage('Validate Host') {
            when {
                expression { return !params.BUILD_ONLY && !params.SKIP_HOST_VALIDATION }
            }
            failFast true
            parallel {
                stage('c7x_host Quick') {
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. dsp-tests/ \
                                -m "quick and not c66x_only and not c7x_only" \
                                --dsp-mode=c7x_host \
                                -v \
                                --junit-xml=${WORKSPACE}/results/c7x_host_quick.xml
                        '''
                    }
                }

                stage('c7x_host Full') {
                    when {
                        expression { return !params.SKIP_LONG_TESTS }
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. dsp-tests/ \
                                -m "not c66x_only and not c7x_only and not quick" \
                                --dsp-mode=c7x_host \
                                -v \
                                --junit-xml=${WORKSPACE}/results/c7x_host_full.xml
                        '''
                    }
                }

                // TIDL host stages use --ignore to exclude test files
                // that internally access AM67A hardware.  Without this,
                // the auto-detect helpers (_has_full_tidl_env) would
                // trigger hardware tests concurrently with c7x_dload.
                stage('TIDL Host Quick') {
                    when {
                        expression { return !params.SKIP_TIDL_TESTS }
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. tidl-tests/ \
                                -m quick \
                                --ignore=tidl-tests/test_tidl_import_e2e.py \
                                --ignore=tidl-tests/test_tidl_new_ops.py \
                                --ignore=tidl-tests/test_tidl_resnet_e2e.py \
                                -v \
                                --junit-xml=${WORKSPACE}/results/tidl_host_quick.xml
                        '''
                    }
                }

                stage('TIDL Host Full') {
                    when {
                        expression { return !params.SKIP_LONG_TESTS && !params.SKIP_TIDL_TESTS }
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. tidl-tests/ \
                                --ignore=tidl-tests/test_tidl_import_e2e.py \
                                --ignore=tidl-tests/test_tidl_new_ops.py \
                                --ignore=tidl-tests/test_tidl_resnet_e2e.py \
                                -k "not TestLayerHardware" \
                                -v \
                                --junit-xml=${WORKSPACE}/results/tidl_host_full.xml
                        '''
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // VALIDATE HARDWARE (sequential -- single DSP core on AM67A)
        //
        // All stages inside this block run one at a time.  The lock
        // prevents a second pipeline run from accessing the board
        // concurrently (defense-in-depth with disableConcurrentBuilds).
        // ----------------------------------------------------------------
        stage('Validate Hardware') {
            when {
                expression { return !params.BUILD_ONLY && !params.SKIP_HW_VALIDATION }
            }
            // Uncomment after creating lockable resource "am67a-dsp-board"
            // in Manage Jenkins > Lockable Resources:
            // options {
            //     lock(resource: 'am67a-dsp-board')
            // }
            stages {
                stage('Board Health Check') {
                    steps {
                        sh '''
                            ssh -o ConnectTimeout=10 \
                                -o StrictHostKeyChecking=no \
                                root@${AM67A_TARGET} \
                                "/usr/local/bin/c7x_compute status" \
                            || {
                                echo "Board unresponsive -- attempting recovery"
                                cd src/runtime/ti_dsp/firmware/c7x
                                ./deploy-c7x.sh --stop  || true
                                sleep 3
                                ./deploy-c7x.sh --start
                                sleep 3
                                ssh -o ConnectTimeout=10 \
                                    root@${AM67A_TARGET} \
                                    "/usr/local/bin/c7x_compute status"
                            }
                        '''
                    }
                }

                stage('Wheel Tests') {
                    when {
                        expression { return !params.SKIP_WHEEL_TESTS }
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. wheel-tests/ \
                                -m quick \
                                -v \
                                --junit-xml=${WORKSPACE}/results/wheel_tests.xml
                        '''
                    }
                }

                stage('c7x_dload Quick') {
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. dsp-tests/ \
                                -m "quick and not c66x_only" \
                                --dsp-mode=c7x_dload \
                                --board-target=${AM67A_TARGET} \
                                -v \
                                --junit-xml=${WORKSPACE}/results/c7x_dload_quick.xml
                        '''
                    }
                }

                stage('c7x_dload Full') {
                    when {
                        expression { return !params.SKIP_LONG_TESTS }
                    }
                    options {
                        timeout(time: 4, unit: 'HOURS')
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. dsp-tests/ \
                                -m "not c66x_only and not quick" \
                                --dsp-mode=c7x_dload \
                                --board-target=${AM67A_TARGET} \
                                -v \
                                --junit-xml=${WORKSPACE}/results/c7x_dload_full.xml
                        '''
                    }
                }

                stage('TIDL HW Quick') {
                    when {
                        expression { return !params.SKIP_TIDL_TESTS }
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. tidl-tests/ \
                                -m quick \
                                -v \
                                --junit-xml=${WORKSPACE}/results/tidl_hw_quick.xml
                        '''
                    }
                }

                stage('TIDL HW Full') {
                    when {
                        expression { return !params.SKIP_LONG_TESTS && !params.SKIP_TIDL_TESTS }
                    }
                    options {
                        timeout(time: 1, unit: 'HOURS')
                    }
                    steps {
                        sh '''
                            mkdir -p results
                            cd tests/ti-dsp-runtime
                            pytest -p no:tvm.testing.plugin --rootdir=. tidl-tests/ \
                                -v \
                                --junit-xml=${WORKSPACE}/results/tidl_hw_full.xml
                        '''
                    }
                }
            }

            post {
                failure {
                    sh '''
                        echo "Hardware stage failed -- attempting firmware recovery"
                        cd src/runtime/ti_dsp/firmware/c7x
                        ./deploy-c7x.sh --stop  || true
                        sleep 3
                        ./deploy-c7x.sh --start || true
                    '''
                }
            }
        }
    }

    // ----------------------------------------------------------------
    // POST: collect results and clean up
    // ----------------------------------------------------------------
    post {
        always {
            junit testResults: 'results/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
            script {
                if (fileExists('results/cycles.csv')) {
                    plot csvFileName: 'dsp_inference_cycles.csv',
                         group: 'DSP Performance',
                         title: 'Inference Cycles (c7x_dload)',
                         style: 'line',
                         yaxis: 'Cycles',
                         csvSeries: [[file: 'results/cycles.csv', displayTableFlag: false, inclusionFlag: 'OFF', url: '']],
                         keepRecords: true
                }
            }
        }
        cleanup {
            script {
                if (!params.KEEP_TEMP_DIRS) {
                    // Clean up temp build dirs from DSP test runs, but only
                    // those owned by the Jenkins user.
                    sh 'find /tmp -maxdepth 1 -name "dsp_build_*" -user "$(id -un)" -exec rm -rf {} + 2>/dev/null || true'
                }
            }
        }
    }
}
